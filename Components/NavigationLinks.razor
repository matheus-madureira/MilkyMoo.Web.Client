<nav class="navigation-links">
    <img src="/images/logo.webp"
         alt="Logo da MilkyMoo"
         class="navigation-logo" />

    <div class="navigation-links-items">
        @foreach (NavigationLink link in Links)
        {
            <NavLink class="nav-link" href="@link.Href" Match="@link.Match">
                <span class="@link.Icon" aria-hidden="true"></span>
                @link.Text
            </NavLink>
        }
    </div>

    @if (TrailingContent is not null)
    {
        <div class="navigation-trailing">
            @TrailingContent
        </div>
    }
</nav>

@code {
    /// <summary>Um item do menu de navegação principal.</summary>
    public sealed record NavigationLink(
        string Text,
        string Href, 
        string Icon, 
        NavLinkMatch Match = NavLinkMatch.Prefix);

    /// <summary>Navegação padrão da aplicação, compartilhada com o menu mobile.</summary>
    public static readonly IReadOnlyList<NavigationLink> DefaultLinks =
    [
        new("Etiquetas", "etiquetas", "bi bi-list-nested-nav-menu"),
        new("Produtos", "produtos", "bi bi-list-nested-nav-menu"),
        new("Estoque", "estoque", "bi bi-plus-square-fill-nav-menu")
    ];

    /// <summary>Conteúdo ancorado à direita da barra, exibido apenas no desktop.</summary>
    [Parameter]
    public RenderFragment? TrailingContent { get; set; }

    /// <summary>Itens exibidos no menu. Substitua para customizar a navegação.</summary>
    [Parameter]
    public IReadOnlyList<NavigationLink> Links { get; set; } = DefaultLinks;
}
