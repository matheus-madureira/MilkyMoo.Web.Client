<article class="etiqueta-card">
    <div class="etiqueta-owner d-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg"
             width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="3"
             stroke-linecap="round"
             stroke-linejoin="round"
             class="lucide lucide-qr-code-icon lucide-qr-code">
            <rect width="5" height="5" x="3" y="3" rx="1" />
            <rect width="5" height="5" x="16" y="3" rx="1" />
            <rect width="5" height="5" x="3" y="16" rx="1" />
            <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
            <path d="M21 21v.01" />
            <path d="M12 7v3a2 2 0 0 1-2 2H7" />
            <path d="M3 12h.01" />
            <path d="M12 3h.01" />
            <path d="M12 16v.01" />
            <path d="M16 12h1" />
            <path d="M21 12v.01" />
            <path d="M12 21v-1" />
        </svg>

        <span>Responsável: @Etiqueta.Responsavel</span>
    </div>

    <h2 class="etiqueta-title">@Etiqueta.Produto</h2>
    <p class="etiqueta-state">Estado atual: @Etiqueta.Estado</p>

    <div class="etiqueta-badges">
        <span class="etiqueta-badge etiqueta-badge-primary">@Etiqueta.Armazenamento</span>
        <span class="etiqueta-badge etiqueta-badge-secondary">@Etiqueta.Quantidade</span>
    </div>

    <div class="etiqueta-footer d-flex align-items-center justify-content-between">
        <span class="etiqueta-date">Aberto em: @Etiqueta.AbertoEm</span>
        <span class="etiqueta-date">Vencimento em: @Etiqueta.VencimentoEm</span>
    </div>

    <div class="etiqueta-actions">
        <button type="button"
                class="etiqueta-action btn btn-lg d-flex align-items-center justify-content-center"
                @onclick="OnDetalhes">
            Detalhes
        </button>

        <button type="button"
                class="etiqueta-action btn btn-lg d-flex align-items-center justify-content-center"
                @onclick="OnImprimir">
            Imprimir
        </button>
    </div>
</article>

@code {
    /// <summary>Uma etiqueta impressa para acompanhamento da validade de um produto.</summary>
    public sealed record EtiquetaImpressa(
        int Id,
        string Responsavel,
        string Produto,
        string Estado,
        string Armazenamento,
        string Quantidade,
        string AbertoEm,
        string VencimentoEm);

    /// <summary>Etiqueta exibida no card.</summary>
    [Parameter, EditorRequired]
    public required EtiquetaImpressa Etiqueta { get; set; }

    /// <summary>Disparado quando o usuário abre os detalhes da etiqueta.</summary>
    [Parameter]
    public EventCallback OnDetalhes { get; set; }

    /// <summary>Disparado quando o usuário solicita a impressão da etiqueta.</summary>
    [Parameter]
    public EventCallback OnImprimir { get; set; }
}
