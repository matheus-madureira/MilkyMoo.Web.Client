<article class="label-card">
    <div class="label-owner d-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg"
             width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="3"
             stroke-linecap="round"
             stroke-linejoin="round"
             class="lucide lucide-qr-code-icon lucide-qr-code">
            <rect width="5" height="5" x="3" y="3" rx="1" />
            <rect width="5" height="5" x="16" y="3" rx="1" />
            <rect width="5" height="5" x="3" y="16" rx="1" />
            <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
            <path d="M21 21v.01" />
            <path d="M12 7v3a2 2 0 0 1-2 2H7" />
            <path d="M3 12h.01" />
            <path d="M12 3h.01" />
            <path d="M12 16v.01" />
            <path d="M16 12h1" />
            <path d="M21 12v.01" />
            <path d="M12 21v-1" />
        </svg>

        <span>Responsável: @Label.Owner</span>
    </div>

    <h2 class="label-title">@Label.Product</h2>
    <p class="label-state">Estado atual: @Label.State</p>

    <div class="label-badges">
        <span class="label-badge label-badge-primary">@Label.Storage</span>
        <span class="label-badge label-badge-secondary">@Label.Quantity</span>
    </div>

    <div class="label-footer d-flex align-items-center justify-content-between">
        <span class="label-date">Aberto em: @Label.OpenedAt</span>
        <span class="label-date">Vencimento em: @Label.ExpiresAt</span>
    </div>

    <div class="label-actions">
        <button type="button"
                class="label-action btn btn-lg d-flex align-items-center justify-content-center"
                @onclick="OnDetails">
            Detalhes
        </button>

        <button type="button"
                class="label-action btn btn-lg d-flex align-items-center justify-content-center"
                @onclick="OnPrint">
            Imprimir
        </button>
    </div>
</article>

@code {
    /// <summary>Uma etiqueta impressa para acompanhamento da validade de um produto.</summary>
    public sealed record PrintedLabel(
        int Id,
        string Owner,
        string Product,
        string State,
        string Storage,
        string Quantity,
        string OpenedAt,
        string ExpiresAt);

    /// <summary>Etiqueta exibida no card.</summary>
    [Parameter, EditorRequired]
    public required PrintedLabel Label { get; set; }

    /// <summary>Disparado quando o usuário abre os detalhes da etiqueta.</summary>
    [Parameter]
    public EventCallback OnDetails { get; set; }

    /// <summary>Disparado quando o usuário solicita a impressão da etiqueta.</summary>
    [Parameter]
    public EventCallback OnPrint { get; set; }
}
