@inject AuthService Auth
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <header class="app-header">
            <div class="app-header-top d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center app-header-brand">
                    <MobileMenu BranchName="Unidade Jardins, São Paulo"
                                UserName="@UserDisplay.Name(context.User)"
                                Role="@UserDisplay.Subtitle(context.User)" />

                    <div class="app-header-branch d-flex align-items-center">
                        <BranchLocation BranchName="Unidade Jardins, São Paulo" />
                    </div>
                </div>

                <div class="d-flex align-items-center app-header-actions">
                    <NotificationsButton />

                    @* Context nomeado: o AuthorizeView de fora já ocupa o "context" padrão. *@
                    <AuthorizeView Policy="@AdminPolicy.Name" Context="admin">
                        <SettingsButton OnClick="GoToSettings" />
                    </AuthorizeView>

                    <LogoutButton OnClick="LogoutAsync" />
                </div>
            </div>

            <NavigationLinks>
                <TrailingContent>
                    <LoggedUser UserName="@UserDisplay.Name(context.User)"
                                Role="@UserDisplay.Subtitle(context.User)" />
                </TrailingContent>
            </NavigationLinks>
        </header>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>Abre o cadastro de usuários, hoje a única tela sob configurações.</summary>
    private void GoToSettings() => Navigation.NavigateTo("configuracoes/usuarios/novo");

    /// <summary>Encerra a sessão e devolve o usuário à tela de entrada.</summary>
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();

        Navigation.NavigateTo("entrar", replace: true);
    }
}
