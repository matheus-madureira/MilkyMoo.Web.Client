@page "/cadastrar"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Criar conta — Milky Moo</PageTitle>

<h1 class="auth-title">Criar conta</h1>

<p class="auth-subtitle">Cadastre-se para emitir e acompanhar as etiquetas da sua unidade.</p>

<form class="auth-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    @if (_error is not null)
    {
        <p class="auth-error" role="alert">@_error</p>
    }

    <div class="auth-row">
        <FormField FieldId="register-first-name"
                   Label="Nome"
                   Required="true"
                   Error="@ErrorOf(FirstNameField)">
            <ChildContent Context="field">
                <input id="@field.FieldId"
                       type="text"
                       autocomplete="given-name"
                       aria-required="true"
                       aria-invalid="@(field.HasError ? "true" : "false")"
                       aria-describedby="@field.DescribedBy"
                       @ref="_firstNameRef"
                       value="@_firstName"
                       @oninput="@(args => Set(FirstNameField, ref _firstName, args))" />
            </ChildContent>
        </FormField>

        <FormField FieldId="register-last-name"
                   Label="Sobrenome"
                   Required="true"
                   Error="@ErrorOf(LastNameField)">
            <ChildContent Context="field">
                <input id="@field.FieldId"
                       type="text"
                       autocomplete="family-name"
                       aria-required="true"
                       aria-invalid="@(field.HasError ? "true" : "false")"
                       aria-describedby="@field.DescribedBy"
                       @ref="_lastNameRef"
                       value="@_lastName"
                       @oninput="@(args => Set(LastNameField, ref _lastName, args))" />
            </ChildContent>
        </FormField>
    </div>

    @* Um campo só: a API exige que o nome de usuário seja o próprio e-mail. *@
    <FormField FieldId="register-email"
               Label="E-mail"
               Required="true"
               Error="@ErrorOf(EmailField)"
               Hint="Será também o seu usuário de acesso.">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="lucide lucide-mail-icon lucide-mail">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
        </Icon>

        <ChildContent Context="field">
            <input id="@field.FieldId"
                   type="email"
                   inputmode="email"
                   autocomplete="username"
                   placeholder="voce@empresa.com"
                   aria-required="true"
                   aria-invalid="@(field.HasError ? "true" : "false")"
                   aria-describedby="@field.DescribedBy"
                   @ref="_emailRef"
                   value="@_email"
                   @oninput="@(args => Set(EmailField, ref _email, args))" />
        </ChildContent>
    </FormField>

    <FormField FieldId="register-password"
               Label="Senha"
               Required="true"
               Error="@ErrorOf(PasswordField)"
               Hint="@($"Mínimo de {AuthValidation.MinimumPasswordLength} caracteres.")"
               Icon="@LockIcon()">
        <ChildContent Context="field">
            <input id="@field.FieldId"
                   type="@(_showPassword ? "text" : "password")"
                   autocomplete="new-password"
                   aria-required="true"
                   aria-invalid="@(field.HasError ? "true" : "false")"
                   aria-describedby="@field.DescribedBy"
                   @ref="_passwordRef"
                   value="@_password"
                   @oninput="@(args => Set(PasswordField, ref _password, args))" />

            <button type="button"
                    class="auth-password-toggle btn"
                    aria-label="@(_showPassword ? "Ocultar senha" : "Mostrar senha")"
                    aria-pressed="@(_showPassword ? "true" : "false")"
                    @onclick="TogglePassword">
                @(_showPassword ? "Ocultar" : "Mostrar")
            </button>
        </ChildContent>
    </FormField>

    <FormField FieldId="register-confirm"
               Label="Confirmar senha"
               Required="true"
               Error="@ErrorOf(ConfirmField)"
               Icon="@LockIcon()">
        <ChildContent Context="field">
            <input id="@field.FieldId"
                   type="@(_showPassword ? "text" : "password")"
                   autocomplete="new-password"
                   aria-required="true"
                   aria-invalid="@(field.HasError ? "true" : "false")"
                   aria-describedby="@field.DescribedBy"
                   @ref="_confirmRef"
                   value="@_confirm"
                   @oninput="@(args => Set(ConfirmField, ref _confirm, args))" />
        </ChildContent>
    </FormField>

    <button type="submit" class="auth-submit btn" disabled="@_busy">
        @(_busy ? "Criando conta..." : "Criar conta")
    </button>

    <p class="auth-switch">
        Já tem conta?
        <a href="@LoginHref">Entrar</a>
    </p>
</form>

@* Os dois campos de senha usam o mesmo cadeado; o fragmento evita repetir o SVG inteiro duas vezes. *@
@code {
    private RenderFragment LockIcon() =>
    @<svg xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-lock-icon lucide-lock">
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </svg>;

    private const string FirstNameField = "firstName";
    private const string LastNameField = "lastName";
    private const string EmailField = "email";
    private const string PasswordField = "password";
    private const string ConfirmField = "confirm";

    private readonly Dictionary<string, string> _errors = [];

    private ElementReference _firstNameRef;
    private ElementReference _lastNameRef;
    private ElementReference _emailRef;
    private ElementReference _passwordRef;
    private ElementReference _confirmRef;

    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _showPassword;
    private bool _busy;

    /// <summary>Destino pretendido antes do redirecionamento para o login. Sempre relativo.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string LoginHref => ReturnUrl is null
        ? "entrar"
        : $"entrar?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private string? ErrorOf(string field) => _errors.GetValueOrDefault(field);

    private void Set(string field, ref string target, ChangeEventArgs args)
    {
        _errors.Remove(field);
        target = args.Value?.ToString() ?? string.Empty;
    }

    private void TogglePassword() => _showPassword = !_showPassword;

    /// <summary>Valida tudo que é possível no cliente — o realm não impõe política de senha.</summary>
    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _errors.Clear();
        _error = null;

        if (string.IsNullOrWhiteSpace(_firstName))
        {
            _errors[FirstNameField] = "Informe seu nome.";
        }

        if (string.IsNullOrWhiteSpace(_lastName))
        {
            _errors[LastNameField] = "Informe seu sobrenome.";
        }

        if (!AuthValidation.IsEmail(_email))
        {
            _errors[EmailField] = "Informe um e-mail válido.";
        }

        if (_password.Length < AuthValidation.MinimumPasswordLength)
        {
            _errors[PasswordField] =
                $"A senha precisa ter ao menos {AuthValidation.MinimumPasswordLength} caracteres.";
        }

        if (_confirm != _password)
        {
            _errors[ConfirmField] = "As senhas não conferem.";
        }

        if (_errors.Count > 0)
        {
            await FocusFirstErrorAsync();
            return;
        }

        _busy = true;

        AuthService.RegisterResult result;

        try
        {
            result = await Auth.RegisterAsync(_firstName, _lastName, _email, _password);
        }
        finally
        {
            _busy = false;
        }

        if (result.Succeeded)
        {
            Navigation.NavigateTo(AuthValidation.SafeReturnUrl(ReturnUrl) ?? "etiquetas", replace: true);
            return;
        }

        // A conta existe, só o login automático falhou: mandar para a entrada em vez de sugerir novo cadastro.
        if (result.AccountCreated)
        {
            Navigation.NavigateTo("entrar?aviso=conta-criada", replace: true);
            return;
        }

        _error = result.Error;
    }

    private ValueTask FocusFirstErrorAsync()
    {
        if (_errors.ContainsKey(FirstNameField))
        {
            return _firstNameRef.FocusAsync();
        }

        if (_errors.ContainsKey(LastNameField))
        {
            return _lastNameRef.FocusAsync();
        }

        if (_errors.ContainsKey(EmailField))
        {
            return _emailRef.FocusAsync();
        }

        return _errors.ContainsKey(PasswordField)
            ? _passwordRef.FocusAsync()
            : _confirmRef.FocusAsync();
    }
}
