@page "/etiquetas"
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Etiquetas Milky Moo</PageTitle>

<div class="labels-page">
    <header class="labels-header">
        <div class="labels-heading">
            <h1 class="page-title">Gerenciar Etiquetas</h1>
            <p class="page-description">Etiquetas Emitidas (@_visibleLabels.Count)</p>
        </div>

        <select class="labels-page-size"
                aria-label="Quantidade de etiquetas exibidas"
                @bind="_pageSize"
                @bind:after="ApplyFilters">
            @foreach (int size in PageSizes)
            {
                <option value="@size">@size itens</option>
            }
        </select>
    </header>

    <div class="labels-body">
        <LabelFilters Labels="_labels ?? []"
                      State="_filters"
                      OnChanged="OnFiltersChanged" />

        <div class="labels-scroll">
            @if (_labels is null)
            {
                <p class="labels-empty">Carregando etiquetas...</p>
            }
            else if (_visibleLabels.Count == 0)
            {
                <p class="labels-empty">Nenhuma etiqueta encontrada para os filtros selecionados.</p>
            }
            else
            {
                <div class="labels-grid">
                    @foreach (LabelCard.PrintedLabel label in _visibleLabels)
                    {
                        <LabelCard @key="label.Id"
                                   Label="label"
                                   OnDetails="() => OpenDetails(label)"
                                   OnPrint="() => OpenPrint(label)" />
                    }
                </div>
            }
        </div>
    </div>
</div>

<Sheet @bind-Open="_isDetailsOpen"
       Title="Detalhes da etiqueta"
       Side="Sheet.SheetSide.Right"
       FooterContent="@(HasExpirationWarning ? ExpirationWarning() : null)">
    @if (_selectedLabel is not null)
    {
        <LabelDetails Label="_selectedLabel" />
    }
</Sheet>

@* Aviso fixo no rodapé: precisa ficar visível sem depender do scroll do painel. *@
@code {
    private RenderFragment ExpirationWarning() =>
    @<div class="labels-warning d-flex align-items-start">
        <svg xmlns="http://www.w3.org/2000/svg"
             width="16"
             height="16"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             class="labels-warning-icon lucide lucide-circle-alert-icon lucide-circle-alert"
             aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" x2="12" y1="8" y2="12" />
            <line x1="12" x2="12.01" y1="16" y2="16" />
        </svg>

        <span>
            Esta etiqueta teve a data de validade modificada respeitando a data de validade original do produto.
        </span>
    </div>;
}

@code {
    private const string DateFormat = "dd/MM/yyyy";

    private static readonly int[] PageSizes = [10, 20, 50, 100];

    private IReadOnlyList<LabelCard.PrintedLabel>? _labels;
    private IReadOnlyList<LabelCard.PrintedLabel> _visibleLabels = [];
    private LabelFilters.LabelFilterState _filters = LabelFilters.LabelFilterState.Empty;
    private int _pageSize = PageSizes[0];

    private LabelCard.PrintedLabel? _selectedLabel;
    private bool _isDetailsOpen;

    private bool HasExpirationWarning => _selectedLabel?.Print?.ExpirationChanged == true;

    protected override async Task OnInitializedAsync()
    {
        _labels = await Http.GetFromJsonAsync<LabelCard.PrintedLabel[]>("sample-data/labels.json");
        ApplyFilters();
    }

    /// <summary>
    /// A etiqueta selecionada não é limpa ao fechar: manter o conteúdo evita o painel piscar vazio
    /// durante a animação de saída.
    /// </summary>
    private void OpenDetails(LabelCard.PrintedLabel label)
    {
        _selectedLabel = label;
        _isDetailsOpen = true;
    }

    /// <summary>A impressão acontece em tela própria, com a pré-visualização e os campos editáveis.</summary>
    private void OpenPrint(LabelCard.PrintedLabel label) =>
        Navigation.NavigateTo($"etiquetas/{label.Id}/imprimir");

    private void OnFiltersChanged(LabelFilters.LabelFilterState filters)
    {
        _filters = filters;
        ApplyFilters();
    }

    /// <summary>Filtra por estado e responsável, ordena por vencimento e limita a quantidade exibida.</summary>
    private void ApplyFilters()
    {
        if (_labels is null)
        {
            _visibleLabels = [];
            return;
        }

        IEnumerable<LabelCard.PrintedLabel> labels = _labels;

        if (_filters.States.Count > 0)
        {
            labels = labels.Where(label => _filters.States.Contains(LabelFilters.StateOf(label)));
        }

        if (_filters.Owners.Count > 0)
        {
            labels = labels.Where(label => _filters.Owners.Contains(label.Owner));
        }

        // Datas inválidas vão para o fim da lista nas duas ordenações.
        labels = _filters.Expiration switch
        {
            LabelFilters.ExpirationOrder.Soonest => labels.OrderBy(label => ExpirationOf(label, DateOnly.MaxValue)),
            LabelFilters.ExpirationOrder.Longest => labels.OrderByDescending(label => ExpirationOf(label, DateOnly.MinValue)),
            _ => labels
        };

        _visibleLabels = labels.Take(_pageSize).ToArray();
    }

    private static DateOnly ExpirationOf(LabelCard.PrintedLabel label, DateOnly fallback) =>
        DateOnly.TryParseExact(label.ExpiresAt, DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly expiresAt)
            ? expiresAt
            : fallback;
}
