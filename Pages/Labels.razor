@page "/etiquetas"
@inject HttpClient Http

<PageTitle>Etiquetas Milky Moo</PageTitle>

<h1 class="page-title">
    GERENCIAR ETIQUETAS
</h1>

<p class="page-description">
    Quantidade de etiquetas impressas para acompanhamento das validades.
</p>

@if (_etiquetas is null)
{
    <p class="etiquetas-empty">Carregando etiquetas...</p>
}
else if (_etiquetas.Count == 0)
{
    <p class="etiquetas-empty">Nenhuma etiqueta impressa até o momento.</p>
}
else
{
    <div class="etiquetas-grid">
        @foreach (LabelCard.EtiquetaImpressa etiqueta in _etiquetas)
        {
            <LabelCard @key="etiqueta.Id" Etiqueta="etiqueta" />
        }
    </div>
}

@code {
    private IReadOnlyList<LabelCard.EtiquetaImpressa>? _etiquetas;

    protected override async Task OnInitializedAsync() =>
        _etiquetas = await Http.GetFromJsonAsync<LabelCard.EtiquetaImpressa[]>("sample-data/labels.json");
}
