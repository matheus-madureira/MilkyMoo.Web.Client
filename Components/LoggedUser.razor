<button type="button"
        class="logged-user btn d-flex align-items-center"
        @onclick="OnClick">
    <img class="logged-user-avatar"
         src="/images/avatar-example.jpg"
         alt="Foto de @UserName" />

    <span class="logged-user-info d-flex flex-column">
        <span class="logged-user-name">@UserName</span>
        <span class="logged-user-role">@Role</span>
    </span>
</button>

@code {
    /// <summary>Nome exibido do usuário autenticado.</summary>
    [Parameter]
    public string UserName { get; set; } = "John Doe";

    /// <summary>Cargo exibido abaixo do nome do usuário.</summary>
    [Parameter]
    public string Role { get; set; } = "Gestor";

    /// <summary>Disparado quando o usuário clica no próprio nome.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }
}
