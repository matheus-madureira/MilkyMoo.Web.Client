<article class="etiqueta-card">
    <div class="etiqueta-owner d-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg"
             width="32"
             height="32"
             fill="currentColor"
             viewBox="0 0 256 256"
             aria-hidden="true">
            <path d="M223.68,66.15,135.68,18a15.88,15.88,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a15.88,15.88,0,0,0,15.36,0l88-48.17a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15ZM128,32l80.34,44-29.77,16.3-80.35-44ZM128,120,47.66,76l33.9-18.56,80.34,44ZM40,90l80,43.78v85.79L40,175.82Zm176,85.78h0l-80,43.79V133.82l32-17.51V152a8,8,0,0,0,16,0V107.55L216,90v85.77Z"></path>
        </svg>

        <span>Responsável: @Etiqueta.Responsavel</span>
    </div>

    <h2 class="etiqueta-title">@Etiqueta.Produto</h2>
    <p class="etiqueta-state">Estado atual: @Etiqueta.Estado</p>

    <div class="etiqueta-badges">
        <span class="etiqueta-badge etiqueta-badge-primary">@Etiqueta.Armazenamento</span>
        <span class="etiqueta-badge etiqueta-badge-secondary">@Etiqueta.Quantidade</span>
    </div>

    <div class="etiqueta-footer d-flex align-items-center justify-content-between">
        <span class="etiqueta-date">Aberto em: @Etiqueta.AbertoEm</span>
        <span class="etiqueta-date">Vencimento em: @Etiqueta.VencimentoEm</span>
    </div>
</article>

@code {
    /// <summary>Uma etiqueta impressa para acompanhamento da validade de um produto.</summary>
    public sealed record EtiquetaImpressa(
        int Id,
        string Responsavel,
        string Produto,
        string Estado,
        string Armazenamento,
        string Quantidade,
        string AbertoEm,
        string VencimentoEm);

    /// <summary>Etiqueta exibida no card.</summary>
    [Parameter, EditorRequired]
    public required EtiquetaImpressa Etiqueta { get; set; }
}
